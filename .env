# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าก่อนใช้งานจริง
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=training
POSTGRES_PASSWORD=training_pass
POSTGRES_DB=training
DB_PORT=5433

# ---- App ----
APP_PORT=8080
JWT_SECRET=change-this-to-a-long-random-string
MAX_UPLOAD_MB=2048

# ---- Admin คนแรก (จองสิทธิ์ admin ล่วงหน้าให้อีเมลนี้ — เปลี่ยนเป็นอีเมล Microsoft 365 จริงของคุณ!) ----
ADMIN_EMAIL=nawat.d@doppiotech.com
ADMIN_NAME=System Admin

# ---- อื่นๆ ----
AUTO_SEED=true

# ---- Microsoft 365 (Entra ID) SSO ----
MICROSOFT_CLIENT_ID=30f979dd-d881-4648-accd-7b0ac3f5c28c
