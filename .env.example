# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าก่อนใช้งานจริง
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=training
POSTGRES_PASSWORD=training_pass
POSTGRES_DB=training
DB_PORT=5433

# ---- App ----
APP_PORT=8080
JWT_SECRET=change-this-to-a-long-random-string
MAX_UPLOAD_MB=2048

# ---- Admin คนแรก (จองสิทธิ์ admin ล่วงหน้าให้อีเมลนี้ — ต้อง login ผ่าน Microsoft 365 ด้วยอีเมลนี้จริงถึงจะเข้าได้) ----
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Admin

# ---- อื่นๆ ----
AUTO_SEED=true

# ---- Microsoft 365 (Entra ID) SSO — ทุกคนในบริษัท login ด้วยบัญชีนี้ ----
# วิธีตั้งค่า: อ่านหัวข้อ "ตั้งค่า Microsoft 365 Login" ใน README.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# ต้องตรงกับ Redirect URI ที่ลงทะเบียนไว้ใน Azure Portal เป๊ะ (รวม path ท้าย /api/auth/microsoft/callback)
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# ---- สำรองข้อมูล ----
# จำนวนวันที่เก็บ backup อัตโนมัติ (backup ที่กดเองไม่ถูกลบตามนี้)
BACKUP_RETENTION_DAYS=3

# ---- Export API (ให้ระบบภายนอกดึงบทเรียนไปใช้ผ่าน /api/export/*) ----
# คีย์คงที่ค่าเดียว ระบบภายนอกต้องส่งมาใน header X-API-Key ให้ตรงกับค่านี้เป๊ะ
# generate ค่าใหม่ได้ด้วย: node -e "console.log('itp_' + require('crypto').randomBytes(24).toString('base64url'))"
EXPORT_API_KEY=
